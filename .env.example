# Copy to .env and fill in. .env is gitignored and must never be committed;
# this file is committed and must never contain a real key.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# OpenRouter — only needed for the paid render backend.
# Key: https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-replace-me

# The image model. Leave this alone unless you have a reason to change it:
# gpt-image-2 is what the free codex backend uses, so keeping it means every
# image in a set comes from one model and the directions stay consistent.
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2

# "high" matches the codex backend. "medium" is roughly a third of the cost and
# noticeably softer — fine for a test run, not for the deliverable.
OPENROUTER_IMAGE_QUALITY=high
