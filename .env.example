# Copy this file to .env and fill in your key.
#
#   cp .env.example .env
#   # then edit .env and paste your key
#
# .env is gitignored and must never be committed. .env.example is committed and
# must never contain a real key.

# ---------------------------------------------------------------------------
# OpenRouter - used only by scripts/render_openrouter.py, which renders the
# photoreal views when the codex image_gen quota is exhausted.
# Get a key at https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-replace-me

# The image model. Leave this alone unless you have a reason to change it:
# gpt-image-2 is the model codex's built-in image_gen tool uses, so keeping it
# means every image in the set comes from the same model and the 20 directions
# stay visually consistent with each other.
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2

# Output quality. "high" matches what codex produces. "medium" is roughly a
# third of the cost and noticeably softer - fine for a test run, not for the
# deliverable.
OPENROUTER_IMAGE_QUALITY=high

# Optional hard spend ceiling in USD for a single --missing run. The script adds
# up the real cost the API reports per image and stops before exceeding this.
# Leave empty for no limit.
OPENROUTER_MAX_SPEND_USD=15
